      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "domain_summary",
            "args": {
              "urls": [
                "https://openai.com/research",
                "https://google.com/search",
                "https://openai.com/blog"
              ]
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_domain_summary",
        "difficulty": "easy",
        "what_it_tests": "Người dùng cung cấp danh sách URL và yêu cầu đếm theo tên miền -> gọi domain_summary"
      }
