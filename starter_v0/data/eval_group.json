{
  "dataset_id": "day04_v2_research_group",
  "dataset_role": "group",
  "description": "Case do nhóm tự viết thêm (5 single-turn, 5 multi-turn), có kiểm tra tool mới domain_summary, boundary action send, query filtering, và multi-turn correction.",
  "allowed_failure_types": [
    "wrong_tool",
